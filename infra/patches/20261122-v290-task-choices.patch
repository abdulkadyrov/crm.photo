+.wt-editor .wt-choice{min-width:0;margin:0;padding:0;border:0;display:block}
+.wt-choice legend{padding:0;margin-bottom:7px;font-size:13px;font-weight:650;line-height:1.4;color:var(--text,#152033)}
+.wt-choice-options{display:flex;flex-wrap:wrap;gap:6px;min-width:0}
+.wt-editor .wt-choice-option{position:relative;display:flex;max-width:100%;margin:0;cursor:pointer;font-weight:500;min-width:0}
+.wt-editor .wt-choice-option input{position:absolute;width:1px;height:1px;padding:0;margin:0;min-height:0;opacity:0;clip-path:inset(50%)}
+.wt-choice-option span{display:flex;align-items:center;min-height:40px;max-width:100%;padding:8px 11px;border:1px solid var(--line,#dce1eb);border-radius:10px;background:var(--card,#fff);color:var(--text,#152033);font-size:13px;line-height:1.35;overflow-wrap:anywhere}
+.wt-choice-option input:checked+span{border-color:var(--primary,#245ee9);background:var(--primary-soft,#eaf0ff);color:var(--primary,#245ee9);font-weight:650}
+.wt-choice-option:hover span{border-color:var(--primary,#245ee9)}
+.wt-choice-option input:focus-visible+span{outline:2px solid var(--primary,#245ee9);outline-offset:2px}
+.wt-choice-option input:disabled+span{opacity:.45;cursor:default}
+.wt-scope-fields>.wt-choice{grid-column:1/-1}
+.wt-editor [hidden]{display:none!important}
+@media(max-width:360px){.wt-choice-option span{font-size:12px;padding:8px 10px}.wt-choice-options{gap:5px}}
