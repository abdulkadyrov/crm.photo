+ async function loadStudentMedia(studentId,{scope,onProgress=()=>{}}={}){
+  if(!enabled||!account()||!scope)return {loaded:0,total:0,errors:[]};
+  const actor=actorKey(),report={loaded:0,total:0,errors:[]};
+  const reply=await json(`/sync/photo-index/${encodeURIComponent(scope)}`);
+  if(actor!==actorKey())throw new Error('Аккаунт изменился. Откройте карточку заново.');
+  const ids=[...new Set((reply.photos||[]).filter(photo=>photo.studentId===studentId).map(photo=>photo.id))];
+  report.total=ids.length;onProgress({...report});
+  let next=0;
+  await Promise.all(Array.from({length:Math.min(2,ids.length)},async()=>{
+   while(next<ids.length){
+    const id=ids[next++];
+    try{
+     const pending=await get('syncQueue',keyOf('media',id));
+     if(pending)continue;
+     const local=await get('media',id);
+     if(!(local?.blob instanceof Blob)){
+      const loaded=await loadRecord('media',id);
+      if(!loaded||loaded.record?.studentId!==studentId||!(loaded.record?.blob instanceof Blob))throw new Error('Исходник не найден');
+      if(actor!==actorKey())throw new Error('Аккаунт изменился');
+      const tx=db.transaction(['media','syncQueue'],'readwrite'),saved=done(tx);
+      tx.objectStore('syncQueue').get(keyOf('media',id)).onsuccess=event=>{
+       if(event.target.result)return;
+       tx.objectStore('media').get(id).onsuccess=current=>{
+        // Do not replace a photo edited locally or received while its bytes downloaded.
+        if(current.target.result?.blob instanceof Blob)return;
+        if(JSON.stringify(current.target.result??null)!==JSON.stringify(local??null))return;
+        tx.objectStore('media').put(loaded.record);
+       };
+      };
+      await saved;
+     }
+     report.loaded++;
+    }catch(error){report.errors.push({id,message:error.message});}
+    finally{onProgress({...report,errors:[...report.errors]});}
+   }
+  }));
+  if(actor!==actorKey())throw new Error('Аккаунт изменился. Откройте карточку заново.');
+  return report;
+ }
+
